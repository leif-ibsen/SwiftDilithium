{"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"","type":"heading","anchor":""},{"inlineContent":[{"text":"Messages are signed by secret keys and signatures are verified by public keys.","type":"text"},{"text":" ","type":"text"},{"text":"Signatures can be deterministic or randomized and optionally a hash of the message can be signed","type":"text"},{"text":" ","type":"text"},{"text":"instead of the message itself.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In order to speed up signing and verifying, the secret key constructor and the public key constructor computes and caches","type":"text"},{"text":" ","type":"text"},{"text":"a variable (called Â in FIPS 204) that is used in subsequent sign and verify operations.","type":"text"},{"text":" ","type":"text"},{"text":"This slows down key construction but significantly improves sign and verify speed.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Example","type":"heading","anchor":"Example"},{"code":["import SwiftDilithium","","\/\/ Create keys","","let (secretKey, publicKey) = Dilithium.GenerateKeyPair(kind: .ML_DSA_44)","","\/\/ Deterministic signature","let deterministicSig = secretKey.Sign(message: [1, 2, 3], randomize: false)","print(\"Deterministic:\", publicKey.Verify(message: [1, 2, 3], signature: deterministicSig))","","\/\/ Randomized signature","let randomizedSig = secretKey.Sign(message: [1, 2, 3], randomize: true)","print(\"Randomized:\", publicKey.Verify(message: [1, 2, 3], signature: randomizedSig))","","\/\/ Prehashed signature","let prehashedSig = secretKey.Sign(message: [1, 2, 3], ph: .SHAKE128)","print(\"Prehashed:\", publicKey.Verify(message: [1, 2, 3], signature: prehashedSig, ph: .SHAKE128))"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"giving:"}],"type":"paragraph"},{"code":["Deterministic: true","Randomized: true","Prehashed: true"],"type":"codeListing","syntax":null}]}],"seeAlsoSections":[{"anchor":"Additional-Information","title":"Additional Information","generated":true,"identifiers":["doc:\/\/SwiftDilithium\/documentation\/SwiftDilithium\/KeyManagement","doc:\/\/SwiftDilithium\/documentation\/SwiftDilithium\/OIDs","doc:\/\/SwiftDilithium\/documentation\/SwiftDilithium\/Performance","doc:\/\/SwiftDilithium\/documentation\/SwiftDilithium\/References"]}],"metadata":{"modules":[{"name":"SwiftDilithium"}],"roleHeading":"Article","role":"article","title":"Sign and Verify"},"hierarchy":{"paths":[["doc:\/\/SwiftDilithium\/documentation\/SwiftDilithium"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdilithium\/signverify"]}],"identifier":{"url":"doc:\/\/SwiftDilithium\/documentation\/SwiftDilithium\/SignVerify","interfaceLanguage":"swift"},"references":{"doc://SwiftDilithium/documentation/SwiftDilithium/OIDs":{"type":"topic","role":"article","abstract":[],"title":"ASN1 OIDs","identifier":"doc:\/\/SwiftDilithium\/documentation\/SwiftDilithium\/OIDs","url":"\/documentation\/swiftdilithium\/oids","kind":"article"},"doc://SwiftDilithium/documentation/SwiftDilithium/Performance":{"type":"topic","role":"article","abstract":[],"title":"Performance","identifier":"doc:\/\/SwiftDilithium\/documentation\/SwiftDilithium\/Performance","url":"\/documentation\/swiftdilithium\/performance","kind":"article"},"doc://SwiftDilithium/documentation/SwiftDilithium":{"role":"collection","title":"SwiftDilithium","type":"topic","identifier":"doc:\/\/SwiftDilithium\/documentation\/SwiftDilithium","abstract":[{"type":"text","text":"Module-Lattice-Based Digital Signature Standard"}],"url":"\/documentation\/swiftdilithium","kind":"symbol"},"doc://SwiftDilithium/documentation/SwiftDilithium/KeyManagement":{"type":"topic","role":"article","abstract":[],"title":"Key Management","identifier":"doc:\/\/SwiftDilithium\/documentation\/SwiftDilithium\/KeyManagement","url":"\/documentation\/