{"variants":[{"paths":["\/documentation\/swiftdilithium\/signverify"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/swiftdilithium.SwiftDilithium\/documentation\/SwiftDilithium"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"anchor":"Additional-Information","identifiers":["doc:\/\/swiftdilithium.SwiftDilithium\/documentation\/SwiftDilithium\/KeyManagement","doc:\/\/swiftdilithium.SwiftDilithium\/documentation\/SwiftDilithium\/OIDs","doc:\/\/swiftdilithium.SwiftDilithium\/documentation\/SwiftDilithium\/Performance","doc:\/\/swiftdilithium.SwiftDilithium\/documentation\/SwiftDilithium\/References"],"title":"Additional Information","generated":true}],"identifier":{"url":"doc:\/\/swiftdilithium.SwiftDilithium\/documentation\/SwiftDilithium\/SignVerify","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"","text":"","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Messages are signed by secret keys and signatures are verified by public keys.","type":"text"},{"text":" ","type":"text"},{"text":"Signatures can be deterministic or randomized and optionally a hash of the message can be signed","type":"text"},{"text":" ","type":"text"},{"text":"instead of the message itself.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In order to speed up signing and verifying, the secret key constructor and the public key constructor computes and caches","type":"text"},{"text":" ","type":"text"},{"text":"a variable (called Â in FIPS 204) that is used in subsequent sign and verify operations.","type":"text"},{"text":" ","type":"text"},{"text":"This slows down key construction but significantly improves sign and verify speed.","type":"text"}]},{"anchor":"Example","text":"Example","type":"heading","level":3},{"code":["import SwiftDilithium","","\/\/ Create keys","","let (secretKey, publicKey) = Dilithium.GenerateKeyPair(kind: .ML_DSA_44)","","\/\/ Deterministic signature","let deterministicSig = secretKey.Sign(message: [1, 2, 3], randomize: false)","print(\"Deterministic:\", publicKey.Verify(message: [1, 2, 3], signature: deterministicSig))","","\/\/ Randomized signature","let randomizedSig = secretKey.Sign(message: [1, 2, 3], randomize: true)","print(\"Randomized:\", publicKey.Verify(message: [1, 2, 3], signature: randomizedSig))","","\/\/ Prehashed signature","let prehashedSig = secretKey.Sign(message: [1, 2, 3], ph: .SHAKE128)","print(\"Prehashed:\", publicKey.Verify(message: [1, 2, 3], signature: prehashedSig, ph: .SHAKE128))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"giving:"}]},{"code":["Deterministic: true","Randomized: true","Prehashed: true"],"type":"codeListing","syntax":null}]}],"metadata":{"role":"article","modules":[{"name":"SwiftDilithium"}],"roleHeading":"Article","title":"Sign and Verify"},"references":{"doc://swiftdilithium.SwiftDilithium/documentation/SwiftDilithium":{"title":"SwiftDilithium","role":"collection","identifier":"doc:\/\/swiftdilithium.SwiftDilithium\/documentation\/SwiftDilithium","kind":"symbol","url":"\/documentation\/swiftdilithium","type":"topic","abstract":[{"text":"Module-Lattice-Based Digital Signature Standard","type":"text"}]},"doc://swiftdilithium.SwiftDilithium/documentation/SwiftDilithium/KeyManagement":{"title":"Key Management","kind":"article","url":"\/documentation\/swiftdilithium\/keymanagement","abstract":[],"identifier":"doc:\/\/swiftdilithium.SwiftDilithium\/documentation\/SwiftDilithium\/KeyManagement","role":"article","type":"topic"},"doc://swiftdilithium.SwiftDilithium/documentation/SwiftDilithium/References":{"title":"References","url":"\/documentation\/swiftdilithium\/references","kind":"article","abstract":[],"identifier":"doc:\/\/swiftdilithium.SwiftDilithium\/documentation\/SwiftDilithium\/References","role":"article","type":"topic"},"doc://swiftdilithium.SwiftDilithium/documentation/SwiftDilithium/Performance":{"identifier":"doc:\/\/swiftdilithium.SwiftDilithium\/documentation\/SwiftDilithium\/Performance","url":"\/documentation\/swiftdilithium\/performance","role":"article","title":"Performance","abstract":[],"kind":"article","type":"topic"},"doc://swiftdilithium.SwiftDilithium/documentation/SwiftDilithium/OIDs":{"title":"ASN1 OIDs","role":"article","identifier":"doc:\/\/swiftdilithium.SwiftDilithium\/documentation\/SwiftDilithium\/OIDs","kind":"article","url":"\/documentation\/swiftdilithium\/oids","type":"topic","abstract":[]}}}